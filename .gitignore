/target
*.log
.DS_Store
/oracle-cache
/REVIEW.md
/tests/fixtures/oracle-out/*.ogg
!/tests/fixtures/oracle-out/.keep

# Audio test corpus is too large/licence-heavy to commit. Contributors
# symlink /corpus to a sound corpus they own (manually run
# `corpus_parity_sweep` from tests/corpus_sweep.rs).
/corpus

# Debug binaries built from tools/debug-libvorbis-dump
# (./tools/debug-libvorbis-dump/build.sh, `just debug-dump-c`) and the
# oracle tools. Never commit host binaries.
/tools/debug-libvorbis-dump/harness
/tools/debug-libvorbis-dump/harness.dSYM/
/tools/debug-libvorbis-dump/corpus_harness
/tools/debug-libvorbis-dump/corpus_harness.dSYM/
/tools/debug-libvorbis-dump/ramp_harness
/tools/debug-libvorbis-dump/ramp_harness.dSYM/
/tools/oracle-encoder/dump_quality_tables
/tools/oracle-encoder/dump_params

# oracle-encoder is the parity oracle used by tests/parity.rs. It must be
# rebuilt locally from the pristine vendored libvorbis sources (run
# ./tools/oracle-encoder/build.sh after pulling). CI rebuilds it from the
# checked-out tree, so the host's macOS arm64 binary should not be
# committed alongside the Linux x86_64 version CI produces.
/tools/oracle-encoder/oracle-encoder
/tools/oracle-encoder/oracle-encoder.dSYM/
.claude/worktrees/
/tools/oracle-encoder/dsp_oracle
/tools/oracle-encoder/dsp_oracle.dSYM/
