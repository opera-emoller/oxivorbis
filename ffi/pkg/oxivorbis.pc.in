prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: oxivorbis
Description: Pure-Rust Ogg Vorbis encoder, byte-identical to libvorbis 1.3.7 (C API)
URL: https://github.com/opera-emoller/oxivorbis
Version: @VERSION@
Libs: -L${libdir} -loxivorbis
Libs.private: @LIBS_PRIVATE@
Cflags: -I${includedir}
